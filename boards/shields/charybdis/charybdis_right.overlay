#include "charybdis.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610-alt";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        cpi = <600>;

        swap-xy;
        invert-x;
        invert-y;    /* invert standard cursor Y axis */

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        force-awake;
    };
};

/ {
    /*
     * Zero-scaler for the volume layer.
     *
     * Intentionally does NOT use the predefined &zip_xy_scaler because that
     * instance has track-remainders enabled — accumulated remainder from cursor
     * movement on other layers would bleed through on the first event after
     * switching to the volume layer, causing a small cursor jump.
     *
     * Without track-remainders, every event is scaled independently:
     * value * 0 / 1 = 0, cleanly, with no state carried between layers.
     */
    zip_xy_nullifier: zip_xy_nullifier {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        /* track-remainders intentionally omitted */
    };

    /*
     * Volume processor.
     *
     * y-invert: inverts Y specifically for the volume layer, independently
     * of the device-level invert-y. Both are intentional:
     *   - invert-y on the device node  → cursor Y is inverted
     *   - y-invert on zip_vol          → volume Y is also inverted
     */
    zip_vol: zip_vol {
        compatible = "zmk,input-processor-volume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        y-input-code = <INPUT_REL_Y>;
        tick = <30>;
        y-invert;
        bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* Layer 1 — scroll */
        scroll {
            layers = <1>;
            input-processors = <&zip_xy_to_scroll_mapper>,
                               <&zip_scroll_scaler 1 2>;
							   <&y-invert>;
        };

        /*
         * Layer 2 — volume only.
         *
         * zip_xy_nullifier zeros both REL_X and REL_Y (no track-remainders
         * so no bleed from other layers), then zip_vol intercepts REL_Y
         * and fires volume keycodes, returning ZMK_INPUT_PROC_STOP so the
         * zeroed REL_Y never reaches the HID accumulator either.
         * REL_X is zeroed and falls through to handle_rel_code with value=0.
         */
        volume {
            layers = <2>;
            input-processors = <&zip_xy_nullifier 0 1>, <&zip_vol>;
        };
    };
};
